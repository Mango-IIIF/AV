{
  "name": "@mango-iiif/av",
  "version": "1.0.0",
  "description": "Framework-free IIIF audio and video components powered by Samvera RAMP.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mango-IIIF/av.git"
  },
  "homepage": "https://github.com/Mango-IIIF/av#readme",
  "bugs": {
    "url": "https://github.com/Mango-IIIF/av/issues"
  },
  "keywords": [
    "iiif",
    "audio",
    "video",
    "ramp",
    "web-components",
    "hls"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js"
    },
    "./chapters": {
      "types": "./dist/chapters.d.ts",
      "import": "./dist/chapters.js"
    },
    "./transcript": {
      "types": "./dist/transcript-element.d.ts",
      "import": "./dist/transcript-element.js"
    },
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "import": "./dist/annotations.js"
    },
    "./captions": {
      "types": "./dist/captions.d.ts",
      "import": "./dist/captions.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsup",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build:lib"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@samvera/ramp": "5.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
